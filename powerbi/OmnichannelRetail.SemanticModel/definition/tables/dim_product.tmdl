	partition dim_product = m
		mode: import
		source =
				let
				    Source = fnLoadCsv("dim_product.csv", false),
				    Typed = Table.TransformColumnTypes(Source, {{"product_key", Int64.Type}, {"sku", type text}, {"product_name", type text}, {"category", type text}, {"subcategory", type text}, {"season", type text}, {"color", type text}, {"list_price", Int64.Type}, {"unit_cost", Int64.Type}}),
				    Banded = Table.AddColumn(Typed, "price_band", each if [list_price] < 250000 then "< 250K" else if [list_price] < 450000 then "250K - 449K" else if [list_price] < 650000 then "450K - 649K" else "650K+", type text)
				in
				    Banded

	annotation PBI_ResultType = Table
